<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted console harness rather than NUnit: §10 allows either, and NUnit would be
     a NuGet dependency for a project whose whole point is having none. -->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1000000-0000-4000-8000-000000000003}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>MoveToNewPC.Tests</RootNamespace>
    <AssemblyName>MoveToNewPC.Tests</AssemblyName>
    <!-- PureMain.cs is a second entry point, for the non-Windows build. The MSBuild build
         is always the full Windows harness, so pick that Main explicitly. -->
    <StartupObject>MoveToNewPC.Tests.Program</StartupObject>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <LangVersion>4</LangVersion>
    <FileAlignment>512</FileAlignment>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>NET40</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols><DebugType>full</DebugType><Optimize>false</Optimize>
    <OutputPath>..\..\build\</OutputPath><DefineConstants>DEBUG;TRACE;NET40</DefineConstants><WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize>
    <OutputPath>..\..\build\</OutputPath><DefineConstants>TRACE;NET40</DefineConstants><WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
    <Compile Include="..\..\src\MoveToNewPC.Core\**\*.cs" Exclude="..\..\src\MoveToNewPC.Core\obj\**\*.cs;..\..\src\MoveToNewPC.Core\bin\**\*.cs">
      <Link>Core\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup><None Include="app.manifest" /></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
